<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/conversation_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" >
    <LinearLayout android:id="@+id/recipient_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="8dp" android:visibility="gone" android:background="#FFFFFFFF">
        <TextView android:id="@+id/recipient_to_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/text_to" android:textColor="@color/conversation_list_details" android:layout_marginEnd="8dp"/>
        <AutoCompleteTextView android:id="@+id/recipient_text_view" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_weight="1" android:singleLine="true" android:hint="@string/text_enter_name_or_number" android:background="@null" android:inputType="phone"/>
        <Button android:id="@+id/pick_contact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/text_contacts" android:textAllCaps="false"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/message_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="16dp" android:paddingBottom="16dp" android:clipToPadding="true"/>
    <include layout="@layout/compose_message_view"/>
</LinearLayout>
