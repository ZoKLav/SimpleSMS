<com.android.messaging.ui.conversation.ConversationMessageView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp">
    <LinearLayout android:id="@+id/message_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <com.android.messaging.ui.ContactIconView android:id="@+id/conversation_icon" android:layout_width="@dimen/conversation_message_contact_icon_size" android:layout_height="@dimen/conversation_message_contact_icon_size" android:visibility="gone"/>
        <LinearLayout android:id="@+id/message_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/message_text_left_right_padding" android:paddingEnd="@dimen/message_text_left_right_padding" android:paddingTop="@dimen/message_text_top_padding" android:paddingBottom="@dimen/message_text_bottom_padding">
            <TextView android:id="@+id/message_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/conversation_message_text_size" android:autoLink="web|phone|email"/>
            <TextView android:id="@+id/message_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:textSize="@dimen/conversation_status_text_size"/>
        </LinearLayout>
    </LinearLayout>
</com.android.messaging.ui.conversation.ConversationMessageView>
