<resources>
    <style name="BugleBaseTheme" parent="Theme.AppCompat.Light.NoActionBar"><item name="windowActionModeOverlay">true</item></style>
    <style name="BugleTheme" parent="BugleBaseTheme"><item name="colorPrimary">@color/action_bar_background_color</item><item name="colorPrimaryDark">@color/action_bar_background_color_dark</item><item name="colorAccent">@color/action_bar_background_color</item><item name="actionBarStyle">@style/BugleActionBar</item></style>
    <style name="BugleActionBar" parent="Widget.AppCompat.Light.ActionBar.Solid"><item name="height">@dimen/action_bar_height</item><item name="titleTextStyle">@style/BugleActionBarTitleTextStyle</item></style>
    <style name="BugleActionBarTitleTextStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title"><item name="android:textColor">@color/action_bar_title_text_color</item><item name="android:textSize">@dimen/action_bar_text_size</item><item name="android:lines">1</item></style>
    <style name="SimpleSMSToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="SimpleSMSPopupThemeLight" parent="ThemeOverlay.AppCompat.Light"/>
    <style name="SimpleSMSPopupThemeDark" parent="ThemeOverlay.AppCompat"/>
    <style name="BugleTheme.ConversationListActivity" parent="BugleTheme"><item name="android:windowBackground">@android:color/white</item></style>
    <style name="BugleTheme.ArchivedConversationListActivity" parent="BugleTheme.ConversationListActivity"><item name="colorPrimary">@color/archived_conversation_action_bar_background_color</item><item name="colorPrimaryDark">@color/archived_conversation_action_bar_background_color_dark</item></style>
    <style name="BugleTheme.ConversationActivity" parent="BugleTheme"><item name="android:windowBackground">@color/conversation_background</item></style>
    <style name="BugleTheme.SettingsActivity" parent="BugleTheme"/>
    <style name="ConversationListItemViewTextStyle"><item name="android:includeFontPadding">true</item><item name="android:textSize">15sp</item><item name="android:textColor">@color/conversation_list_details</item></style>
    <style name="ConversationListItemViewConversationNameStyle" parent="ConversationListItemViewTextStyle"><item name="android:textSize">17sp</item><item name="android:textColor">@color/conversation_list_name</item></style>
    <style name="ConversationComposeSendText"><item name="android:textSize">17sp</item><item name="android:gravity">center_vertical</item><item name="android:maxLines">4</item><item name="android:background">@null</item><item name="android:paddingLeft">8dp</item><item name="android:paddingRight">8dp</item></style>
    <style name="BugleTheme.Dark" parent="Theme.AppCompat.NoActionBar"><item name="colorPrimary">@color/action_bar_background_color</item><item name="colorPrimaryDark">@color/action_bar_background_color_dark</item><item name="colorAccent">@color/action_bar_background_color</item><item name="actionBarStyle">@style/BugleActionBar</item><item name="android:windowBackground">#212121</item></style>
</resources>
